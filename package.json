{
  "name": "ai-context-hub",
  "version": "0.1.0",
  "description": "Local-first workspace for auditing, budgeting, importing, and exporting AI coding context.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/mason2048/ai-context-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mason2048/ai-context-hub.git"
  },
  "bugs": {
    "url": "https://github.com/mason2048/ai-context-hub/issues"
  },
  "keywords": [
    "ai-context",
    "agents",
    "local-first",
    "context-management",
    "developer-tools"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
